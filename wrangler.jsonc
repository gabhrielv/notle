{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notle",
  "main": "src/entry.py",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["python_workers"],

  // One Worker serves both the built front and the API. Same origin, so no
  // CORS and no preflight on a request that is already personalized.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notle",
      "database_id": "4be63ca6-d903-40b7-bef8-9eaea0ad139f",

      // Onde `wrangler d1 migrations` procura. As cinco primeiras foram
      // aplicadas à mão antes disto existir e estão registradas na tabela de
      // controle, para que a sexta suba por comando em vez de por memória.
      "migrations_dir": "migrations"
    }
  ],

  // O relógio da ingestão. O job continua no Actions, porque o normalizador
  // depende de spaCy e isso não roda no runtime do Worker; o que muda de lugar
  // é só quem pede a execução.
  //
  // `cron` no Actions é melhor esforço e a fila é descartada sob carga: medido
  // em 31 execuções, mediana de 96 min contra uma hora pedida, pior caso de 221.
  // Um Cron Trigger daqui dispara `workflow_dispatch`, que não é evento
  // enfileirado e não sofre o mesmo represamento.
  //
  // Mesmo horário de antes, aos :17 e :47, fora dos minutos redondos onde toda
  // fila do mundo dispara. A diferença é que agora eles acontecem.
  "triggers": {
    "crons": ["17,47 * * * *"]
  },

  "vars": {
    // Qual repositório receber o disparo. Aqui e não no código porque é
    // configuração de implantação, e o token que a acompanha é segredo
    // (`wrangler secret put GITHUB_TOKEN`).
    "GITHUB_REPOSITORY": "gabhrielv/notle"
  },

  "observability": {
    "enabled": true
  }
}
